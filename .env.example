# ==============================================================================
# AdventureOS — Variables de Entorno para Producción / Vercel
# ==============================================================================

# 1. Base de Datos (PostgreSQL / Neon Serverless)
# En Neon Console -> Connect, obtienes ambas cadenas de conexión:
# A) Cadena con Pooling (PgBouncer) para las consultas de la aplicación en Vercel:
DATABASE_URL="postgresql://usuario:password@ep-ejemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# B) Cadena Directa (Unpooled) para Prisma CLI (migraciones y db push):
DIRECT_URL="postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth & Seguridad
# En Vercel, usa la URL de tu despliegue (o dominio personalizado):
NEXTAUTH_URL="https://sunkart-pc.vercel.app"
# Genera un secreto seguro con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-con-un-secreto-criptografico-seguro"

# 3. Proveedor de Pasarela de Pago ("MOCK" o "AZUL")
# Con "MOCK", el sistema opera y procesa reservas demo completas sin requerir banco.
PAYMENT_DEFAULT_PROVIDER="MOCK"

# 4. Credenciales AZUL (República Dominicana) — Requerido solo si PAYMENT_DEFAULT_PROVIDER="AZUL"
AZUL_MERCHANT_ID="39000000000"
AZUL_MERCHANT_NAME="SunKart Park Punta Cana"
AZUL_AUTH_KEY="00000000000000000000000000000000"
AZUL_ENVIRONMENT="TEST"
AZUL_API_URL="https://pruebas.azul.com.do/PaymentPage/"
